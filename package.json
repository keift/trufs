{
  "name": "trufs",
  "version": "1.2.39",
  "description": "Trusty file methods.",
  "license": "MIT",
  "homepage": "https://github.com/keift/trufs",
  "repository": "https://github.com/keift/trufs",
  "scripts": {
    "tests": "bun check && bun run lint && bun test",
    "retouch": "bun run prettier",
    "build": "tsdown",
    "lint": "eslint ./",
    "prettier": "prettier --write ./"
  },
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "types": "./dist/main.d.mts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "types": "./dist/types.d.mts"
    }
  },
  "dependencies": {
    "@types/fs-extra": "latest",
    "@types/graceful-fs": "latest",
    "atomically": "latest",
    "fs-extra": "latest",
    "graceful-fs": "latest"
  },
  "devDependencies": {
    "prettier": "latest",
    "rulint": "latest",
    "tsdown": "latest"
  },
  "keywords": [
    "fs",
    "file-system",
    "atomically",
    "fs-extra",
    "graceful-fs",
    "atomic",
    "atomic-reads",
    "atomic-writes"
  ]
}
